{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fxga-macro-intelligence-dashboard",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "main": "./worker/src/auth-gateway.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.7-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    "FXGA_RUNTIME": "cloudflare-r0",
    "AUTH_ENFORCED": "auto",
    "AUTH_SERVICE_URL": "https://fxga-trading-academy.few-nose.workers.dev",
    "AUTH_PORTAL_URL": "https://fxga-trading-academy.few-nose.workers.dev/member"
  }
}
