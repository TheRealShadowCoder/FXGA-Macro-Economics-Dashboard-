{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fxga-macro-intelligence-dashboard",
  "account_id": "4f260a0775a3df407e08512610c9898b",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index-v3.ts",
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FXGA_COORDINATOR",
        "class_name": "FxgaCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FxgaCoordinator"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "FXGA Macro Intelligence",
    "CACHE_TTL_SECONDS": "300",
    "BROWSER_SOFT_BUDGET_SECONDS": "0",
    "COLLECTOR_MODE": "external-webhook"
  }
}
