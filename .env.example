# Local development only. Never commit real values.
# The Cloudflare-hosted frontend uses this public Google Cloud Run base URL for all API and WebSocket traffic.
VITE_GOOGLE_CLOUD_API_BASE=

# Collector-side credentials belong in Google Secret Manager / collector deployment, not Cloudflare.
FRED_API_KEY=
TRADING_ECONOMICS_API_KEY=
NEWS_API_KEY=
