{
  "schema": "fxga.mt5.broker-symbol-profiles.v1",
  "policy": {
    "matching": "exact-terminal-symbol-only",
    "caseInsensitive": true,
    "preferSpotOrCash": true,
    "rejectAmbiguous": true,
    "notes": [
      "Profiles generate candidates only. A mapping is written only when the exact symbol is exposed by the connected MT5 terminal.",
      "US2Y and US10Y remain unmapped unless a broker exposes the actual yield instrument; bond futures are not treated as Treasury yields.",
      "Cash/spot indices and energies are preferred over dated/futures contracts for continuous macro event studies."
    ]
  },
  "brokers": {
    "Deriv": {
      "serverHints": ["Deriv"],
      "accountTypes": {"all": {"suffixes": [""]}},
      "cryptoPrefixes": [""],
      "symbols": {
